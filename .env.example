# Copy to .env and paste your key from https://dashboard.sarvam.ai
# .env is gitignored: never commit a real key.
SARVAM_API_KEY=

# Optional overrides (defaults shown)
# KAVACH_STT_MODEL=saaras:v4
# KAVACH_LLM_MODEL=sarvam-105b
# KAVACH_REASONING=            # empty = thinking off (fast). Set to low for deeper but ~6 s slower analysis
# KAVACH_RISK_THRESHOLD=70
# KAVACH_DADI_PACE=0.8
# KAVACH_REAL_DATA_BLOCKLIST=  # comma-separated real numbers Dadi must never say, e.g. your phone number
